
#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 2 ]]; then
  echo "Usage: $0 <DEV|SIT|UAT> <workspace>" >&2
  exit 1
fi

ENV_NAME="${1^^}"
WORKSPACE="$(realpath "$2")"
APP_ROOT="/var/www/product-ui"
NODE_BIN="/home/ec2-user/.nvm/versions/node/v22.13.0/bin"
RUN_AS_EC2="/usr/sbin/runuser"

case "$ENV_NAME" in
  DEV) BASE_URL="http://prod-dev.work.gd/api" ;;
  SIT) BASE_URL="http://prod-sit.work.gd/api" ;;
  UAT) BASE_URL="http://prod-uat.work.gd/api" ;;
  *)
    echo "Unsupported environment: $ENV_NAME" >&2
    exit 1
    ;;
esac

ENV_LOWER="${ENV_NAME,,}"
APP_DIR="$APP_ROOT/$ENV_LOWER"
DIST_DIR="$APP_DIR/dist"
ENV_FILE="$APP_ROOT/.env.$ENV_LOWER"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Run this helper through sudo." >&2
  exit 1
fi

if [[ ! -d "$WORKSPACE" ||
      ! -f "$WORKSPACE/package.json" ||
      ! -f "$WORKSPACE/package-lock.json" ]]; then
  echo "Invalid Jenkins workspace: $WORKSPACE" >&2
  exit 1
fi

if [[ ! -r "$ENV_FILE" ]]; then
  echo "Environment file missing or unreadable: $ENV_FILE" >&2
  exit 1
fi

if [[ ! -x "$RUN_AS_EC2" ||
      ! -x "$NODE_BIN/node" ||
      ! -x "$NODE_BIN/npm" ]]; then
  echo "runuser or Node.js installation is missing." >&2
  exit 1
fi

for file in vite.config.js src/main.jsx; do
  if [[ ! -f "$WORKSPACE/$file" ]]; then
    echo "Required UI file missing: $WORKSPACE/$file" >&2
    exit 1
  fi
done

echo "==> Deploying $ENV_NAME UI"
echo "==> Source: $WORKSPACE"
echo "==> Target: $APP_DIR"

install -d -o ec2-user -g ec2-user "$APP_DIR"

# Preserve environment files and copy only the selected branch's source.
rsync -a --delete \
  --exclude='.git/' \
  --exclude='node_modules/' \
  --exclude='dist/' \
  --exclude='.env' \
  --exclude='.env.*' \
  "$WORKSPACE/" "$APP_DIR/"

chown -R ec2-user:ec2-user "$APP_DIR"

echo "==> Installing dependencies"

"$RUN_AS_EC2" -u ec2-user -- env \
  HOME=/home/ec2-user \
  PATH="$NODE_BIN:/usr/local/bin:/usr/bin:/bin" \
  bash -c 'cd "$1" && npm ci --no-audit --no-fund' \
  _ "$APP_DIR"

echo "==> Building frontend"

"$RUN_AS_EC2" -u ec2-user -- env \
  HOME=/home/ec2-user \
  PATH="$NODE_BIN:/usr/local/bin:/usr/bin:/bin" \
  VITE_ENV="$ENV_NAME" \
  VITE_API_BASE_URL="$BASE_URL" \
  bash -c 'cd "$1" && npm run build' \
  _ "$APP_DIR"

if [[ ! -s "$DIST_DIR/index.html" ]]; then
  echo "Build did not produce $DIST_DIR/index.html" >&2
  exit 1
fi

if ! id nginx >/dev/null 2>&1; then
  echo "Nginx user does not exist; verify Nginx installation." >&2
  exit 1
fi

chown -R nginx:nginx "$DIST_DIR"
chmod -R u=rwX,go=rX "$DIST_DIR"

echo "==> Frontend deployment successful for $ENV_NAME"
